---
import "@styles/form.css";

interface Props {
   action?: string;
   method?: "get" | "post" | "dialog";
   id?: string;
   name?: string;
   novalidate?: boolean;
   autocomplete?: "on" | "off";
   enctype?: string;
   target?: string;
   // Form-level error message: Rendered in a live region below the fields.
   error?: string;
   class?: string;
   style?: string;
   "aria-label"?: string;
   "aria-labelledby"?: string;
}

const { class: className, novalidate = true, error, id, ...rest } = Astro.props;

const errorId = id ? `${id}-error` : undefined;
---

<form
   class:list={["form", className]}
   novalidate={novalidate}
   id={id}
   data-module="form"
   {...rest}
>
   <slot />
   {
      error && (
         <p class="form-error" id={errorId} role="alert">
            {error}
         </p>
      )
   }
   <slot name="error" />
</form>

<script>
   document
      .querySelectorAll<HTMLFormElement>('[data-module="form"]')
      .forEach((form) => {
         // Flag form so styles can dim it and locks double-submits
         form.addEventListener("submit", (e) => {
            if (form.hasAttribute("data-submitting")) {
               e.preventDefault();
               return;
            }
            form.setAttribute("data-submitting", "");
         });

         // Prevents bfcache (back button) from leaving the form stuck in its submitting state
         window.addEventListener("pageshow", () => {
            form.removeAttribute("data-submitting");
         });
      });
</script>
