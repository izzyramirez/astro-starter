---
interface Props {
   class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["accordion-list", className]} data-module="accordion">
   <slot />
</div>

<script>
   import gsap from "gsap";
   import { ScrollTrigger } from "gsap/ScrollTrigger";

   gsap.registerPlugin(ScrollTrigger);

   // Counter lives outside the module loop on purpose so two components can work together
   let count = 0;

   document
      .querySelectorAll<HTMLElement>('[data-module="accordion"]')
      .forEach((module) => {
         const items = module.querySelectorAll<HTMLElement>(".accordion-item");

         items.forEach((item) => {
            const id = `accordion-${++count}`;
            const btn =
               item.querySelector<HTMLButtonElement>(".accordion-trigger");
            const content =
               item.querySelector<HTMLElement>(".accordion-content");
            const icon = item.querySelector<HTMLElement>(".accordion-icon");

            if (!btn || !content) return;

            btn.id = `trigger-${id}`;
            btn.setAttribute("aria-controls", `content-${id}`);
            btn.setAttribute("aria-expanded", "false");
            content.id = `content-${id}`;
            content.setAttribute("role", "region");
            content.setAttribute("aria-labelledby", `trigger-${id}`);
            // Inert hides focus from contents before accordion is expanded
            content.setAttribute("inert", "");

            gsap.set(content, { height: 0 });

            let tl: gsap.core.Timeline | undefined;

            btn.addEventListener("click", () => {
               if (tl) tl.kill();

               const isExpanded = btn.getAttribute("aria-expanded") === "true";
               btn.setAttribute("aria-expanded", String(!isExpanded));
               if (isExpanded) content.setAttribute("inert", "");
               else content.removeAttribute("inert");

               if (!isExpanded) item.setAttribute("data-open", "");

               tl = gsap.timeline({
                  onComplete: () => {
                     if (isExpanded) item.removeAttribute("data-open");
                     ScrollTrigger.refresh();
                  },
               });

               tl.to(content, {
                  height: isExpanded ? 0 : "auto",
                  duration: 0.4,
                  ease: "power2.inOut",
               });
               if (icon) {
                  tl.to(
                     icon,
                     {
                        rotateZ: isExpanded ? 0 : -45,
                        duration: 0.4,
                        ease: "power2.inOut",
                     },
                     "<",
                  );
               }
            });
         });
      });
</script>

<style>
   @layer base, component, utility;

   @layer component {
      .accordion-list {
         display: flex;
         flex-direction: column;
         gap: var(--space-16);
      }
   }
</style>
