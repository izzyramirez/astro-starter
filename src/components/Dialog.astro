---
import Button from "./Button.astro";
import Close from "@assets/icons/Close.astro";

interface Props {
   triggerLabel?: string;
   label?: string; //Accessible name for dialog. Gets announced when opened
   class?: string;
}

const {
   triggerLabel = "Open",
   label = triggerLabel,
   class: className,
} = Astro.props;
---

<div class:list={["dialog-component", className]} data-module="dialog">
   <Button type="button" data-dialog-trigger aria-haspopup="dialog">
      {triggerLabel}
   </Button>
   <dialog data-dialog-panel aria-label={label}>
      <div class="modal">
         <button
            class="modal_close-button"
            type="button"
            data-dialog-close
            aria-label="Close dialog"
         >
            <Close stroke={1.5} />
         </button>
         <slot />
      </div>
   </dialog>
</div>

<script>
   document
      .querySelectorAll<HTMLElement>('[data-module="dialog"]')
      .forEach((module) => {
         const panel = module.querySelector<HTMLDialogElement>(
            "[data-dialog-panel]",
         );
         const trigger = module.querySelector<HTMLElement>(
            "[data-dialog-trigger]",
         );
         if (!panel || !trigger) return;

         trigger.addEventListener("click", () => panel.showModal());

         module
            .querySelectorAll<HTMLElement>("[data-dialog-close]")
            .forEach((el) => el.addEventListener("click", () => panel.close()));

         panel.addEventListener("click", (e) => {
            if (e.target === panel) panel.close();
         });
      });
</script>

<style>
   @layer base, component, utility;

   @layer component {
      html:has(dialog[open]) {
         overflow: hidden;
      }

      dialog {
         background-color: var(--color-bg-page);
         border-radius: var(--radius-lg);
         border: 1px solid var(--color-border-default);
         width: 100%;
         max-width: min(calc(100% - (var(--page-gutter) * 2)), 50rem);
         max-height: calc(100svh - (var(--page-gutter) * 2));
         padding: 0;
      }

      dialog[open],
      dialog[open]::backdrop {
         animation: dialog-fadein var(--duration-sm) var(--ease-out-sine)
            forwards;
      }

      dialog::backdrop {
         background: var(--color-bg-overlay);
      }

      @keyframes dialog-fadein {
         from {
            opacity: 0;
         }
         to {
            opacity: 1;
         }
      }

      .modal {
         padding: var(--space-20);
         position: relative;
      }

      .modal_close-button {
         display: flex;
         justify-content: center;
         align-items: center;
         width: var(--space-32);
         height: var(--space-32);
         padding: var(--space-4);
         border-radius: var(--radius-sm);
         position: absolute;
         inset: 0.5rem 0.5rem auto auto;
         transition: background-color var(--duration-sm) var(--ease-out-sine);
      }

      @media (hover: hover) and (pointer: fine) {
         .modal_close-button:hover {
            background-color: color-mix(
               in srgb,
               var(--color-text-strong) 6%,
               transparent
            );
         }
      }
   }
</style>
