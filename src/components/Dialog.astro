---
import Button from "./Button.astro";
import Close from "@assets/icons/Close.astro";

interface Props {
   triggerLabel?: string;
   class?: string;
}

const { triggerLabel = "Open", class: className } = Astro.props;
---

<div class:list={["dialog-component", className]} data-module="dialog">
   <Button type="button" aria-controls="">
      {triggerLabel}
   </Button>
   <dialog>
      <div class="modal">
         <button
            class="modal_close-button"
            type="button"
            aria-label="Close dialog"
         >
            <Close stroke={1.5} />
         </button>
         <slot />
      </div>
   </dialog>
</div>

<script>
   // TODO: Check code
   let modalCount = 0;

   document
      .querySelectorAll<HTMLElement>('[data-module="dialog"]')
      .forEach((module) => {
         const id = `modal-${++modalCount}`;
         const dialogEl = module.querySelector<HTMLDialogElement>("dialog");
         const btnOpen = module.querySelector<HTMLElement>("[aria-controls]");
         const btnClose =
            module.querySelector<HTMLButtonElement>("dialog button");

         if (!dialogEl || !btnOpen || !btnClose) return;

         dialogEl.id = id;
         btnOpen.setAttribute("aria-controls", id);
         btnOpen.id = `trigger-${id}`;

         btnOpen.addEventListener("click", () => dialogEl.showModal());

         btnClose.addEventListener("click", () => dialogEl.close());

         dialogEl.addEventListener("click", (e) => {
            const rect = dialogEl.getBoundingClientRect();
            if (
               e.clientX < rect.left ||
               e.clientX > rect.right ||
               e.clientY < rect.top ||
               e.clientY > rect.bottom
            ) {
               dialogEl.close();
            }
         });
      });
</script>

<style>
   @layer base, component, utility;

   @layer component {
      html:has(dialog[open]) {
         overflow: hidden;
      }

      dialog {
         background-color: var(--color-bg-page);
         border-radius: var(--radius-lg);
         border: 1px solid var(--color-border-default);
         width: 100%;
         max-width: min(calc(100% - (var(--section-padding) * 2)), 50rem);
         max-height: calc(100svh - (var(--section-padding) * 2));
         padding: 0;
      }

      dialog[open],
      dialog[open]::backdrop {
         animation: dialog-fadein var(--duration-sm) var(--ease-out-sine)
            forwards;
      }

      dialog::backdrop {
         background: var(--color-bg-overlay);
      }

      @keyframes dialog-fadein {
         from {
            opacity: 0;
         }
         to {
            opacity: 1;
         }
      }

      .modal {
         padding: var(--space-20);
         position: relative;
      }

      .modal_close-button {
         display: flex;
         justify-content: center;
         align-items: center;
         width: var(--space-32);
         height: var(--space-32);
         padding: var(--space-4);
         border-radius: var(--radius-sm);
         position: absolute;
         inset: 0.5rem 0.5rem auto auto;
         transition: background-color var(--duration-sm) var(--ease-out-sine);
      }

      @media (hover: hover) and (pointer: fine) {
         .modal_close-button:hover {
            background-color: color-mix(
               in srgb,
               var(--color-text-strong) 6%,
               transparent
            );
         }
      }
   }
</style>
