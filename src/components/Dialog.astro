---
import Button from './Button.astro';
import Close from '@assets/icons/Close.astro';

interface Props {
  triggerLabel?: string;
  class?: string;
}

const { triggerLabel = 'Open', class: className } = Astro.props;
---

<div class:list={['dialog-component', className]} data-module="dialog">
  <Button type="button" aria-controls="">
    {triggerLabel}
  </Button>
  <dialog>
    <div class="modal">
      <button class="modal_close-button" type="button" aria-label="Close dialog">
        <Close />
      </button>
      <slot />
    </div>
  </dialog>
</div>

<script>
let modalCount = 0;

document.querySelectorAll<HTMLElement>('[data-module="dialog"]').forEach((module) => {
  const id = `modal-${++modalCount}`;
  const dialogEl = module.querySelector<HTMLDialogElement>('dialog');
  const btnOpen = module.querySelector<HTMLElement>('[aria-controls]');
  const btnClose = module.querySelector<HTMLButtonElement>('dialog button');

  if (!dialogEl || !btnOpen || !btnClose) return;

  dialogEl.id = id;
  btnOpen.setAttribute('aria-controls', id);
  btnOpen.id = `trigger-${id}`;

  btnOpen.addEventListener('click', () => dialogEl.showModal());
  btnClose.addEventListener('click', () => dialogEl.close());

  dialogEl.addEventListener('click', (e) => {
    const rect = dialogEl.getBoundingClientRect();
    if (
      e.clientX < rect.left ||
      e.clientX > rect.right ||
      e.clientY < rect.top ||
      e.clientY > rect.bottom
    ) {
      dialogEl.close();
    }
  });
});
</script>
