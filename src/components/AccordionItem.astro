---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={['accordion-item', className]}>
  <button class="accordion-trigger" type="button">
    <span class="accordion-title">{title}</span>
    <span class="accordion-icon_right" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 2V14M2 8H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </span>
  </button>
  <div class="accordion-content">
    <div class="accordion-content_spacer">
      <slot />
    </div>
  </div>
</div>
