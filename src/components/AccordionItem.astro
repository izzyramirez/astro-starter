---
import Plus from '@assets/icons/Plus.astro';

interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={['accordion-item', className]}>
  <button class="accordion-trigger" type="button">
    <span class="accordion-title">{title}</span>
    <span class="accordion-icon_right" aria-hidden="true">
      <Plus />
    </span>
  </button>
  <div class="accordion-content">
    <div class="accordion-content_spacer">
      <slot />
    </div>
  </div>
</div>
