---
import FooterLinkGroup from "./FooterLinkGroup.astro";
import { footerMenu } from "@/data/navigation";
import Company from "@/assets/icons/Company.astro";
import FaceNeutral from "@/assets/icons/FaceNeutral.astro";
---

<footer class="footer">
   <div class="container">
      <div class="footer-main">
         <div class="footer-brand">
            <a href="/" class="footer-logo">
               <Company class="u-svg-fluid" />
               <span class="u-sr-only">Company_name</span>
            </a>
         </div>
         <div class="footer-menu">
            {
               footerMenu.map((group) => (
                  <FooterLinkGroup title={group.title} links={group.links} />
               ))
            }
         </div>
      </div>
      <div class="footer-bottom">
         <p class="footer-legal">
            &copy; <span current-year></span> Boilerplate. All rights reserved.
         </p>
         <div class="footer-social">
            <a href="#">
               <FaceNeutral stroke={1.5} />
            </a>
         </div>
      </div>
   </div>
</footer>

<style>
   @layer base, component, utility;

   @layer component {
      .footer {
         border-top: 1px solid var(--color-border-default);
         background-color: var(--color-bg-page);
         padding-left: var(--page-gutter);
         padding-right: var(--page-gutter);
      }

      .footer-main {
         display: grid;
         grid-template-columns: repeat(
            auto-fit,
            minmax(min(22.25rem, 100%), 1fr)
         );
         column-gap: var(--gap-md);
         row-gap: var(--gap-xl);
         padding: var(--space-48) 0 var(--space-48);
      }

      .footer-brand {
         min-width: 0;
      }

      .footer-logo {
         display: block;
         max-width: 4rem;
      }

      .footer-menu {
         min-width: 0;
         display: grid;
         grid-template-columns: repeat(auto-fit, minmax(min(6rem, 100%), 1fr));
         column-gap: var(--gap-md);
         row-gap: var(--gap-lg);
      }

      .footer-bottom {
         border-top: 1px solid var(--color-border-default);
         display: flex;
         justify-content: space-between;
         align-items: center;
         flex-wrap: wrap;
         gap: var(--gap-sm);
         padding: var(--space-24) 0 var(--space-36);
      }

      .footer-legal {
         font-size: var(--text-sm);
         color: var(--color-text-soft);
      }

      .footer-social {
         display: flex;
         gap: 0.75rem;
         list-style: none;
         padding: 0;
         margin: 0;
      }

      .footer-social a {
         display: flex;
         align-items: center;
         justify-content: center;
         width: var(--space-20);
         height: var(--space-20);
         color: var(--color-text-soft);
         text-decoration: none;
         transition: color var(--duration-xs) var(--ease-out-power-2);
      }

      /* Hovers */
      @media (hover: hover) and (pointer: fine) {
         .footer-logo:hover,
         .footer-social a:hover {
            color: var(--color-text-accent);
         }
      }
   }
</style>
