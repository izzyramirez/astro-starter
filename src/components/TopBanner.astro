---
import { banner } from "@/data/banner";

interface Props {
   text?: string;
   href?: string;
   show?: boolean;
   label?: string;
   class?: string;
}

// Content falls back to src/data/banner.ts. Pass props to override one instance
const {
   text = banner.text,
   href = banner.href,
   show = banner.enabled,
   label = banner.label ?? "Announcement",
   class: className,
} = Astro.props;

const Tag = href ? "a" : "div";
---

{
   show && (
      <aside class:list={["banner", className]} aria-label={label}>
         <Tag class="banner-inner" href={href}>
            <p class="container banner-text">{text}</p>
         </Tag>
      </aside>
   )
}

<style>
   @layer base, component, utility;

   @layer component {
      .banner {
         background-color: var(--color-bg-accent);
         color: var(--primitive-neutral-0);
      }

      .banner-inner {
         display: block;
         padding: var(--space-6) var(--page-gutter);
         color: inherit;
         text-decoration: none;
         border-radius: 0;
      }

      .banner-text {
         text-align: center;
         font-size: var(--text-xs);
         font-weight: var(--weight-medium);
      }

      a.banner-inner:focus-visible {
         outline: var(--outline-width) solid var(--primitive-neutral-0);
         outline-offset: calc((var(--outline-width) * -1) - 1px);
      }

      @media (hover: hover) and (pointer: fine) {
         a.banner-inner:hover .banner-text {
            text-decoration: underline;
            text-underline-offset: 0.05em;
            text-underline-position: under;
         }
      }
   }
</style>
