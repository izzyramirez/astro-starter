---
import NavItem from "./NavItem.astro";
import { mainMenu } from "@/data/navigation";
import Button from "./Button.astro";
import Menu from "@assets/icons/Menu.astro";
import Close from "@assets/icons/Close.astro";
import Company from "@/assets/icons/Company.astro";

interface Props {
   logoHref?: string;
}

const { logoHref = "/" } = Astro.props;
---

<header class="nav" data-module="nav">
   <div class="container inner-nav">
      <div class="nav-backdrop" aria-hidden="true"></div>
      <a class="nav-logo" href={logoHref} aria-label="Home">
         <Company class="u-svg-fluid" />
      </a>

      <ul class="nav-menu" id="nav-menu" role="list">
         {mainMenu.map((item) => <NavItem item={item} />)}
      </ul>

      <div class="nav-end">
         <Button href="#" class="nav-button">Get started</Button>
         <button
            class="nav-burger"
            type="button"
            aria-expanded="false"
            aria-controls="nav-menu"
            aria-label="Open navigation"
         >
            <span class="nav-burger-icon--open" aria-hidden="true"
               ><Menu stroke={1.5} /></span
            >
            <span class="nav-burger-icon--close" aria-hidden="true"
               ><Close stroke={1.5} /></span
            >
         </button>
      </div>
   </div>
</header>

<script>
   import gsap from "gsap";

   const nav = document.querySelector<HTMLElement>('[data-module="nav"]');

   if (nav) {
      const burger = nav.querySelector<HTMLButtonElement>(".nav-burger");
      const menu = nav.querySelector<HTMLElement>(".nav-menu");
      const drops = nav.querySelectorAll<HTMLElement>(".nav-dropdown");

      // The desktop breakpoint is defined once, in the @container rule
      // below; this reads the flag that rule sets so CSS and JS cannot drift.
      const isDesktop = () =>
         !!menu &&
         getComputedStyle(menu).getPropertyValue("--nav-desktop").trim() ===
            "1";

      // ── Dropdown helpers ───────────────────────────────────

      function closeDropdown(dd: HTMLElement, instant = false) {
         const trigger = dd.querySelector<HTMLButtonElement>(
            ".nav-dropdown-trigger",
         );
         const panel = dd.querySelector<HTMLElement>(".nav-dropdown-panel");
         if (
            !trigger ||
            !panel ||
            trigger.getAttribute("aria-expanded") !== "true"
         )
            return;

         trigger.setAttribute("aria-expanded", "false");
         panel.setAttribute("inert", "");

         if (instant) {
            gsap.killTweensOf(panel);
            panel.style.pointerEvents = "";
            gsap.set(panel, { clearProps: "all" });
         } else if (isDesktop()) {
            gsap.to(panel, {
               opacity: 0,
               y: -4,
               duration: 0.15,
               ease: "power1.in",
               overwrite: true,
               onComplete: () => {
                  panel.style.pointerEvents = "none";
               },
            });
         } else {
            gsap.to(panel, {
               height: 0,
               duration: 0.2,
               ease: "power1.in",
               overwrite: true,
            });
         }
      }

      function openDropdown(trigger: HTMLButtonElement, panel: HTMLElement) {
         trigger.setAttribute("aria-expanded", "true");
         panel.removeAttribute("inert");

         if (isDesktop()) {
            gsap.set(panel, { clearProps: "height,overflow" });
            panel.style.pointerEvents = "auto";
            gsap.fromTo(
               panel,
               { opacity: 0, y: -6 },
               {
                  opacity: 1,
                  y: 0,
                  duration: 0.22,
                  ease: "power2.out",
                  overwrite: true,
               },
            );
         } else {
            gsap.set(panel, { clearProps: "opacity,y,transform" });
            panel.style.pointerEvents = "";
            gsap.to(panel, {
               height: "auto",
               duration: 0.3,
               ease: "power2.out",
               overwrite: true,
            });
         }
      }

      // ── Dropdown click handlers ────────────────────────────

      drops.forEach((dd) => {
         const trigger = dd.querySelector<HTMLButtonElement>(
            ".nav-dropdown-trigger",
         );
         const panel = dd.querySelector<HTMLElement>(".nav-dropdown-panel");
         if (!trigger || !panel) return;

         panel.setAttribute("inert", "");

         trigger.addEventListener("click", () => {
            const isOpen = trigger.getAttribute("aria-expanded") === "true";
            drops.forEach((d) => {
               if (d !== dd) closeDropdown(d);
            });
            if (isOpen) closeDropdown(dd);
            else openDropdown(trigger, panel);
         });
      });

      // ── Burger / mobile menu ───────────────────────────────

      if (burger && menu) {
         const b = burger;

         // Visibility is CSS's job (see the :has() rule in <style>);
         // this only owns the state attribute.
         function openMenu() {
            b.setAttribute("aria-expanded", "true");
            b.setAttribute("aria-label", "Close navigation");
         }

         function closeMenu() {
            b.setAttribute("aria-expanded", "false");
            b.setAttribute("aria-label", "Open navigation");
            drops.forEach((d) => closeDropdown(d, true));
         }

         b.addEventListener("click", () => {
            b.getAttribute("aria-expanded") === "true"
               ? closeMenu()
               : openMenu();
         });

         nav.querySelector<HTMLElement>(".nav-backdrop")?.addEventListener(
            "click",
            closeMenu,
         );
      }

      // ── Global handlers ────────────────────────────────────

      document.addEventListener("click", (e) => {
         if (!(e.target as Element).closest('[data-module="nav"]')) {
            drops.forEach((d) => closeDropdown(d));
         }
      });

      document.addEventListener("keydown", (e) => {
         if (e.key !== "Escape") return;
         drops.forEach((d) => closeDropdown(d));
         if (burger?.getAttribute("aria-expanded") === "true") {
            burger.setAttribute("aria-expanded", "false");
            burger.setAttribute("aria-label", "Open navigation");
            drops.forEach((d) => closeDropdown(d, true));
         }
      });

      // Reset GSAP overrides on resize so CSS media queries take back control
      let resizeId: ReturnType<typeof setTimeout>;
      window.addEventListener(
         "resize",
         () => {
            clearTimeout(resizeId);
            resizeId = setTimeout(() => {
               drops.forEach((d) => {
                  const trigger = d.querySelector<HTMLButtonElement>(
                     ".nav-dropdown-trigger",
                  );
                  const panel = d.querySelector<HTMLElement>(
                     ".nav-dropdown-panel",
                  );
                  if (trigger) trigger.setAttribute("aria-expanded", "false");
                  if (panel) {
                     gsap.killTweensOf(panel);
                     panel.style.pointerEvents = "";
                     gsap.set(panel, { clearProps: "all" });
                  }
               });
               if (burger) {
                  burger.setAttribute("aria-expanded", "false");
                  burger.setAttribute("aria-label", "Open navigation");
               }
            }, 150);
         },
         { passive: true },
      );
   }
</script>

<style>
   @layer base, component, utility;

   @layer component {
      .nav {
         z-index: 999;
         border-bottom: 1px solid var(--color-border-default);
         background-color: var(--color-bg-page);
         padding: var(--space-16) var(--page-gutter);
         position: sticky;
         top: 0;
      }

      .inner-nav {
         display: flex;
         align-items: center;
         gap: var(--space-16);
      }

      .nav-logo {
         display: flex;
         align-items: center;
         text-decoration: none;
         color: inherit;
         flex-shrink: 0;
         width: 100%;
         max-width: 3.5rem;
      }

      .nav-menu {
         display: none;
         flex-direction: column;
         align-items: stretch;
         gap: var(--space-12);
         margin: 0;
         padding: var(--page-gutter);
         position: absolute;
         top: calc(100% + 1px);
         left: 0;
         width: 100%;
         max-height: calc(100svh - 100%);
         overscroll-behavior: contain;
         overflow-y: auto;
         background-color: var(--color-bg-page);
         border-bottom: 1px solid var(--color-border-default);
      }

      .nav-backdrop {
         display: none;
         position: absolute;
         top: calc(100% + 1px);
         left: 0;
         right: 0;
         height: 100vh;
         background-color: var(--color-bg-overlay);
      }

      /* Aria state controls */
      .nav:has(.nav-burger[aria-expanded="true"]) .nav-menu {
         display: flex;
      }

      .nav:has(.nav-burger[aria-expanded="true"]) .nav-backdrop {
         display: block;
      }

      .nav-end {
         display: flex;
         align-items: center;
         gap: var(--space-8);
         flex-shrink: 0;
         margin-left: auto;
      }

      .nav-button {
         max-height: 2rem;
         min-height: unset;
         border-radius: var(--radius-md);
         --btn-px: 0.625em;
      }

      /* Burger */
      .nav-burger {
         width: 2rem;
         height: 2rem;
         display: flex;
         align-items: center;
         justify-content: center;
         padding: var(--space-4);
         border-radius: var(--radius-md);
         border: solid 1px var(--color-border-default);
      }

      .nav-burger-icon--close {
         display: none;
      }
      .nav-burger[aria-expanded="true"] .nav-burger-icon--open {
         display: none;
      }
      .nav-burger[aria-expanded="true"] .nav-burger-icon--close {
         display: block;
      }

      /* Breakpoint */
      /* -- Must match Nav.astro min-width */
      @container container (min-width: 52rem) {
         /* Nav script reads var for menus */
         .nav-menu {
            --nav-desktop: 1;
            max-height: none;
            overflow: visible;
            border-bottom: none;
         }

         .nav-burger {
            display: none;
         }

         .nav-menu,
         .nav:has(.nav-burger[aria-expanded="true"]) .nav-menu {
            margin-left: auto;
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: var(--space-4);
            padding: 0;
            position: static;
            width: auto;
            background-color: transparent;
         }

         /* Backdrop controls */
         .nav-backdrop,
         .nav:has(.nav-burger[aria-expanded="true"]) .nav-backdrop {
            display: none;
         }

         .nav:has(
               .nav-dropdown.cc-mega .nav-dropdown-trigger[aria-expanded="true"]
            )
            .nav-backdrop {
            display: block;
         }

         .nav-end {
            margin-left: 0;
         }
      }
   }
</style>
