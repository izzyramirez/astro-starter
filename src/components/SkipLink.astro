---
interface Props {
   href?: string;
   label?: string;
}

const { href = "#main-content", label = "Skip to main content" } = Astro.props;
---

<a class="skip-link" href={href}>{label}</a>

<style>
   @layer base, component, utility;

   @layer component {
      .skip-link {
         opacity: 0;
         z-index: 9999;
         background-color: var(--color-bg-page);
         color: var(--color-text-strong);
         font-size: var(--text-sm);
         font-weight: var(--weight-medium);
         line-height: var(--leading-100);
         height: 2.25em;
         padding: 0.625em 0.625em;
         border-radius: 0;
         border-bottom-right-radius: var(--radius-sm);
         text-decoration: none;
         text-align: center;
         display: flex;
         justify-content: center;
         align-items: center;
         position: fixed;
         top: 0;
         left: 0;
         border-bottom: 1px solid var(--color-text-strong);
         border-right: 1px solid var(--color-text-strong);
         margin-top: -4em;
      }

      .skip-link:focus-visible {
         outline: none;
         opacity: 1;
         margin-top: 0;
      }
   }
</style>
