---
import ChevronDown from '@assets/icons/ChevronDown.astro';

interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<li class:list={['nav-dropdown', className]}>
  <button class="nav-link nav-dropdown-trigger" type="button" aria-expanded="false" aria-haspopup="true">
    {label}
    <span class="nav-dropdown-arrow" aria-hidden="true">
      <ChevronDown />
    </span>
  </button>
  <div class="nav-dropdown-panel cc-mega" role="region">
    <div class="nav-mega-inner">
      <slot />
    </div>
  </div>
</li>
