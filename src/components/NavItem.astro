---
import ChevronDown from "@assets/icons/ChevronDown.astro";
import type { NavItem } from "@/data/navigation";

interface Props {
   item: NavItem;
   class?: string;
}

const { item, class: className } = Astro.props;

const href = "href" in item ? item.href : undefined;
const links = "links" in item ? item.links : undefined;
const columns = "columns" in item ? item.columns : undefined;
---

{
   href ? (
      <li class:list={className}>
         <a class="nav-link" href={href}>
            {item.label}
         </a>
      </li>
   ) : (
      <li class:list={["nav-dropdown", columns && "cc-mega", className]}>
         <button
            class="nav-link nav-dropdown-trigger"
            type="button"
            aria-expanded="false"
            aria-haspopup="true"
         >
            {item.label}
            <span class="nav-dropdown-arrow" aria-hidden="true">
               <ChevronDown />
            </span>
         </button>
         <div
            class:list={["nav-dropdown-panel", columns && "cc-mega"]}
            role="region"
         >
            {columns ? (
               <div class="nav-mega-inner">
                  <div class="nav-mega-grid">
                     {columns.map((column) => (
                        <div>
                           <p class="nav-mega-title">{column.title}</p>
                           {column.links.map((link) => (
                              <a class="nav-dropdown-link" href={link.href}>
                                 {link.label}
                              </a>
                           ))}
                        </div>
                     ))}
                  </div>
               </div>
            ) : (
               links?.map((link) => (
                  <a class="nav-dropdown-link" href={link.href}>
                     {link.label}
                  </a>
               ))
            )}
         </div>
      </li>
   )
}

<style>
   @layer base, component, utility;

   @layer component {
      .nav-link {
         font-size: var(--text-h4);
         font-weight: var(--weight-medium);
         border-radius: 0;
         width: 100%;
         padding: var(--space-4) 0;
         display: flex;
         justify-content: flex-start;
         align-items: center;
         gap: 0.25em;
         text-decoration: none;
      }

      .nav-dropdown {
         position: relative;
         width: 100%;
      }

      .nav-dropdown-arrow {
         width: 0.875em;
         height: 0.875em;
         margin-top: 0.175em;
         display: inline-flex;
         align-items: center;
         transition: transform var(--duration-xs) var(--ease-out-power-2);
      }

      .nav-dropdown-trigger[aria-expanded="true"] .nav-dropdown-arrow {
         transform: rotate(180deg);
      }

      .nav-dropdown-panel {
         min-width: 0;
         height: 0;
         padding: 0;
         overflow: hidden;
         border: none;
         border-radius: 0;
         opacity: 1;
         pointer-events: auto;
      }

      .nav-dropdown-link {
         display: block;
         padding: 0.5em 0;
         border-top: 1px solid var(--color-border-default);
         border-radius: 0;
         color: inherit;
         text-decoration: none;
         font-size: var(--text-h6);
         transition: background-color var(--duration-xs) var(--ease-out-power-2);
      }

      .nav-mega-inner {
         padding-top: var(--space-12);
      }

      .nav-mega-grid {
         display: grid;
         grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
         gap: var(--gap-lg);
      }

      .nav-mega-title {
         font-size: var(--text-sm);
         font-weight: var(--weight-medium);
         color: var(--color-text-soft);
         margin-bottom: var(--space-8);
      }

      /* Breakpoint */
      /* -- Must match Nav.astro min-width */
      @container container (min-width: 52rem) {
         .nav-link {
            font-size: var(--text-sm);
            width: auto;
            padding: 0.25em 0.5em;
            border: none;
            border-radius: var(--radius-md);
            justify-content: center;
         }

         .nav-dropdown {
            width: auto;
         }

         .nav-dropdown-panel {
            position: absolute;
            top: calc(100% + var(--space-16));
            left: 0;
            min-width: 220px;
            height: auto;
            padding: var(--space-6);
            overflow: visible;
            border: 1px solid var(--color-border-default);
            border-radius: var(--radius-md);
            background-color: var(--color-bg-page);
            opacity: 0;
            pointer-events: none;
         }

         .nav-dropdown-link {
            font-size: var(--text-sm);
            padding: 0.25rem 0.5rem;
            border: none;
            border-radius: var(--radius-sm);
         }

         .nav-dropdown.cc-mega {
            position: static;
         }

         .nav-dropdown-panel.cc-mega {
            position: absolute;
            top: calc(100% + 1px);
            left: 0;
            right: 0;
            border-top: none;
            border-inline: none;
            border-radius: 0;
            padding: 0 var(--page-gutter);
         }

         .nav-mega-inner {
            max-width: var(--container-max-default);
            margin: 0 auto;
            padding: var(--space-32) 0;
         }

         .nav-dropdown-panel.cc-mega .nav-dropdown-link {
            border-radius: 0;
            padding: 0.5em 0;
            border-top: solid 1px var(--color-border-default);
         }
      }

      @media (hover: hover) and (pointer: fine) {
         .nav-link:hover {
            background-color: color-mix(
               in srgb,
               var(--color-text-strong) 6%,
               transparent
            );
         }

         .nav-dropdown-link:hover {
            background-color: var(--color-bg-surface);
         }
      }
   }
</style>
