---
interface Props {
   width?: number | string;
   height?: number | string;
   class?: string;
   "aria-hidden"?: "true" | "false";
}
const { class: className, "aria-hidden": ariaHidden = "true" } = Astro.props;
---

<svg
   class={className}
   viewBox="0 0 24 24"
   fill="none"
   xmlns="http://www.w3.org/2000/svg"
   aria-hidden={ariaHidden}
>
   <path
      d="M12 5V19M5 12H19"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
</svg>
