---
interface Props {
  width?: number | string;
  height?: number | string;
  class?: string;
  'aria-hidden'?: 'true' | 'false';
}
const { width = 20, height = 20, class: className, 'aria-hidden': ariaHidden = 'true' } = Astro.props;
---
<svg class={className} width={width} height={height} viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden={ariaHidden}>
  <path d="M3 5H17M3 10H17M3 15H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
</svg>
