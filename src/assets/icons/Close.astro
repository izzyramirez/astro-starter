---
interface Props {
   width?: number | string;
   height?: number | string;
   class?: string;
   stroke?: number;
   "aria-hidden"?: "true" | "false";
}
const {
   class: className,
   "aria-hidden": ariaHidden = "true",
   stroke = 2,
} = Astro.props;
---

<svg
   class={className}
   viewBox="0 0 24 24"
   fill="none"
   xmlns="http://www.w3.org/2000/svg"
   aria-hidden={ariaHidden}
>
   <path
      d="M18 6L6 18M6 6L18 18"
      stroke="currentColor"
      stroke-width={stroke}
      stroke-linecap="round"
      stroke-linejoin="round"></path>
</svg>
