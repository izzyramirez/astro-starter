---
interface Props {
  width?: number | string;
  height?: number | string;
  class?: string;
  'aria-hidden'?: 'true' | 'false';
}
const { width = 16, height = 16, class: className, 'aria-hidden': ariaHidden = 'true' } = Astro.props;
---
<svg class={className} width={width} height={height} viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden={ariaHidden}>
  <path d="M3 6L8 11L13 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
