---
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
   post: CollectionEntry<"blog">;
}

export const getStaticPaths: GetStaticPaths = async () => {
   // Annotated explicitly so `post`/`data` don't fall back to implicit `any`
   // if the generated `astro:content` types haven't been synced yet.
   const posts: CollectionEntry<"blog">[] = await getCollection("blog");

   return posts
      .filter((post) => !post.data.draft)
      .map((post) => ({
         params: { id: post.id },
         props: { post },
      }));
};

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, author, ogImage } = post.data;
const { Content } = await render(post);

const dateFormat = new Intl.DateTimeFormat("en-US", {
   year: "numeric",
   month: "long",
   day: "numeric",
   timeZone: "UTC",
});
---

<BaseLayout
   title={title}
   description={description}
   ogType="article"
   ogImage={ogImage}
   datePublished={pubDate}
   dateModified={updatedDate}
   breadcrumbItem={title}
>
   <section class="section">
      <article class="container article">
         <header>
            <p class="eyebrow kicker">Blog</p>

            <h1 class="title">{title}</h1>

            <p class="paragraph-lg lede">
               {description}
            </p>

            <p class="paragraph-sm byline">
               By {author} ·{" "}
               <time datetime={pubDate.toISOString()}
                  >{dateFormat.format(pubDate)}</time
               >
               {
                  updatedDate && (
                     <>
                        {" "}
                        · Updated{" "}
                        <time datetime={updatedDate.toISOString()}>
                           {dateFormat.format(updatedDate)}
                        </time>
                     </>
                  )
               }
            </p>

            <span class="u-divider rule"></span>
         </header>

         <div class="rich-text body">
            <Content />
         </div>
      </article>
   </section>
</BaseLayout>

<style>
   @layer base, component, utility;

   @layer component {
      .section {
         padding: var(--section-padding-default) var(--page-gutter);
      }
      .article {
         max-width: 40rem;
      }
      .title {
         margin-top: var(--space-16);
      }
      .kicker,
      .lede {
         color: var(--color-text-soft);
      }
      .lede {
         margin-top: var(--space-16);
      }
      .rule {
         margin-block: var(--space-40);
      }
      .body {
         max-width: 65ch;
      }
      .byline {
         color: var(--color-text-fade);
         margin-top: var(--space-24);
      }
   }
</style>
