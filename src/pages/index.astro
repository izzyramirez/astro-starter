---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import Accordion from '@components/Accordion.astro';
import AccordionItem from '@components/AccordionItem.astro';
import Dialog from '@components/Dialog.astro';
import ArrowRight from '@assets/icons/ArrowRight.astro';
---

<BaseLayout
  title="Astro Starter"
  description="A modern Astro 6 starter with CSS layers, General Sans, GSAP, and utility components."
>    <!-- Hero -->
    <section style="padding: 8rem 5vw 6rem; max-width: 80rem; margin: 0 auto;">
      <p class="eyebrow">Astro Starter</p>
      <h1 style="max-width: 16ch;">Build something<br>worth finishing.</h1>
      <p class="paragraph-xl u-text-soft" style="max-width: 52ch; margin-top: 1rem;">
        A modern Astro 6 template with CSS cascade layers, fluid typography, GSAP, and accessible components — no Webflow required.
      </p>
      <div class="u-d-flex gap-sm" style="flex-wrap: wrap; margin-top: 2rem;">
        <Button href="#">
          Get started
          <ArrowRight slot="icon-right" />
        </Button>
        <Button href="#" variant="outline">View docs</Button>
      </div>
    </section>

    <!-- Cards -->
    <section style="padding: 4rem 5vw; max-width: 80rem; margin: 0 auto; border-top: 1px solid var(--color-border);">
      <p class="eyebrow">Components</p>
      <h2>Cards</h2>
      <div class="u-d-flex gap-lg u-flex-wrap" style="margin-top: 2rem;">
        <div class="card" style="flex: 1; min-width: 220px;">
          <div class="card-body">
            <p class="eyebrow">Token</p>
            <h3 class="h5">Design tokens</h3>
            <p class="paragraph-sm u-text-soft u-mb-0">All colors, typography, and spacing live in <code>tokens.css</code> as CSS custom properties.</p>
          </div>
        </div>
        <div class="card" style="flex: 1; min-width: 220px;">
          <div class="card-body">
            <p class="eyebrow">CSS</p>
            <h3 class="h5">Cascade layers</h3>
            <p class="paragraph-sm u-text-soft u-mb-0">Organized into <code>@layer base, component, utility</code> for predictable specificity without hacks.</p>
          </div>
        </div>
        <div class="card" style="flex: 1; min-width: 220px;">
          <div class="card-body">
            <p class="eyebrow">JS</p>
            <h3 class="h5">GSAP components</h3>
            <p class="paragraph-sm u-text-soft u-mb-0">Nav dropdowns, accordions, and dialogs powered by GSAP with accessible ARIA attributes.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Buttons -->
    <section style="padding: 4rem 5vw; max-width: 80rem; margin: 0 auto; border-top: 1px solid var(--color-border);">
      <p class="eyebrow">Components</p>
      <h2>Buttons</h2>
      <div class="u-d-flex gap-sm u-flex-wrap" style="margin-top: 2rem; align-items: center;">
        <Button href="#">Primary</Button>
        <Button href="#" variant="outline">Outline</Button>
        <Button href="#" variant="ghost">Ghost</Button>
        <Button href="#">
          With icon
          <ArrowRight slot="icon-right" />
        </Button>
      </div>
    </section>

    <!-- Accordion -->
    <section style="padding: 4rem 5vw; max-width: 80rem; margin: 0 auto; border-top: 1px solid var(--color-border);">
      <div class="u-d-flex gap-xl u-flex-wrap">
        <div style="flex: 1; min-width: 220px;">
          <p class="eyebrow">Components</p>
          <h2>Accordion</h2>
          <p class="u-text-soft">Animated with GSAP. ARIA attributes auto-applied on init.</p>
        </div>
        <div style="flex: 2; min-width: 300px;">
          <Accordion>
            <AccordionItem title="What is this starter template?">
              <p>A production-ready Astro 6 base with CSS cascade layers, fluid typography, GSAP components, and an SEO layout — no jQuery or Webflow required.</p>
            </AccordionItem>
            <AccordionItem title="How do I customize the design tokens?">
              <p>All design tokens live in <code>src/styles/tokens.css</code>. Colors, type scale, spacing, and radii are CSS custom properties you can override at <code>:root</code>.</p>
            </AccordionItem>
            <AccordionItem title="Can I add more components?">
              <p>Yes. Follow the pattern in <code>Accordion.astro</code> and <code>Dialog.astro</code>. Scripts are bundled by Vite and deduped automatically by Astro.</p>
            </AccordionItem>
          </Accordion>
        </div>
      </div>
    </section>

    <!-- Dialog -->
    <section style="padding: 4rem 5vw; max-width: 80rem; margin: 0 auto; border-top: 1px solid var(--color-border);">
      <p class="eyebrow">Components</p>
      <h2>Dialog</h2>
      <p class="u-text-soft">Uses the native <code>&lt;dialog&gt;</code> element. Closes on backdrop click or Escape.</p>
      <div style="margin-top: 2rem;">
        <Dialog triggerLabel="Open dialog">
          <h3 class="h4 u-mb-sm">Dialog title</h3>
          <p>This dialog uses the native <code>&lt;dialog&gt;</code> element with <code>showModal()</code> and <code>close()</code>. IDs and ARIA attributes are auto-generated on init.</p>
          <p class="u-mb-0 u-text-soft paragraph-sm">Click outside or the × button to close.</p>
        </Dialog>
      </div>
    </section>

    <!-- Typography -->
    <section style="padding: 4rem 5vw; max-width: 80rem; margin: 0 auto; border-top: 1px solid var(--color-border);">
      <p class="eyebrow">Typography</p>
      <h2>Type scale</h2>
      <div style="margin-top: 2rem;">
        <h1>Heading 1</h1>
        <h2>Heading 2</h2>
        <h3>Heading 3</h3>
        <h4>Heading 4</h4>
        <h5>Heading 5</h5>
        <h6>Heading 6</h6>
        <span class="u-divider" style="margin: 2rem 0; display: block;"></span>
        <p class="paragraph-xl">Paragraph XL — lead copy or hero subtext.</p>
        <p class="paragraph-lg">Paragraph LG — intro or callout text.</p>
        <p>Paragraph base — body copy. Text wraps with <code>text-wrap: pretty</code> to avoid orphaned words.</p>
        <p class="paragraph-sm u-text-soft">Paragraph SM — captions, metadata, helper text.</p>
        <p class="eyebrow">Eyebrow label</p>
      </div>
    </section>

    <!-- Form -->
    <section style="padding: 4rem 5vw 8rem; max-width: 80rem; margin: 0 auto; border-top: 1px solid var(--color-border);">
      <p class="eyebrow">Components</p>
      <h2>Form</h2>
      <form class="form" novalidate style="max-width: 480px; margin-top: 2rem;">
        <div class="input-group">
          <label class="input-label" for="demo-name">Full name</label>
          <input class="input" type="text" id="demo-name" name="name" placeholder="Jane Smith" />
        </div>
        <div class="input-group">
          <label class="input-label" for="demo-email">Email address</label>
          <input class="input" type="email" id="demo-email" name="email" placeholder="jane@example.com" />
        </div>
        <div class="input-group cc-textarea">
          <label class="input-label" for="demo-message">Message</label>
          <textarea class="input" id="demo-message" name="message" placeholder="Your message..."></textarea>
        </div>
        <Button type="submit" full>Send message</Button>
      </form>
    </section>
</BaseLayout>
