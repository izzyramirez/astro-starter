---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import AccordionList from "@components/AccordionList.astro";
import AccordionItem from "@components/AccordionItem.astro";
import Dialog from "@components/Dialog.astro";
import Form from "@components/Form.astro";
import ArrowRight from "@assets/icons/ArrowRight.astro";
import ChevronDown from "@assets/icons/ChevronDown.astro";
import TopBanner from "@components/TopBanner.astro";
---

<BaseLayout
   title="Astro Starter"
   description="A modern Astro 7 starter with CSS layers, General Sans, GSAP, and utility components."
>
   <TopBanner
      slot="banner"
      text="Boilerplate is a lightweight Astro framework"
      href="/"
   />

   <!-- Hero -->
   <section class="section cc-hero">
      <div class="container">
         <p class="eyebrow">Astro Starter</p>
         <h1 style="max-width: 16ch;">Build something<br />worth finishing.</h1>
         <p
            class="paragraph-xl u-text-muted"
            style="max-width: 52ch; margin-top: 1rem;"
         >
            A modern <a href="astro.build">Astro 7</a> template with CSS cascade layers,
            fluid typography, GSAP, and accessible components — no Webflow required.
         </p>
         <div
            class="u-d-flex gap-sm"
            style="flex-wrap: wrap; margin-top: 2rem;"
         >
            <Button href="#">
               Get started
               <ArrowRight slot="icon-right" />
            </Button>
            <Button href="#" variant="outline">View docs</Button>
         </div>
      </div>
   </section>

   <!-- Cards -->
   <section class="section">
      <div class="container">
         <p class="eyebrow">Components</p>
         <h2>Cards</h2>
         <div class="u-d-flex gap-lg u-flex-wrap" style="margin-top: 2rem;">
            <div class="card" style="flex: 1; min-width: 220px;">
               <p class="eyebrow">Token</p>
               <h3 class="h5">Design tokens</h3>
               <p class="paragraph-sm u-text-soft u-mb-0">
                  All colors, typography, and spacing live in <code
                     >tokens.css</code
                  > as CSS custom properties.
               </p>
            </div>
            <div class="card" style="flex: 1; min-width: 220px;">
               <p class="eyebrow">CSS</p>
               <h3 class="h5">Cascade layers</h3>
               <p class="paragraph-sm u-text-soft u-mb-0">
                  Organized into <code>@layer base, component, utility</code> for
                  predictable specificity without hacks.
               </p>
            </div>
            <div class="card" style="flex: 1; min-width: 220px;">
               <p class="eyebrow">JS</p>
               <h3 class="h5">GSAP components</h3>
               <p class="paragraph-sm u-text-soft u-mb-0">
                  Nav dropdowns, accordions, and dialogs powered by GSAP with
                  accessible ARIA attributes.
               </p>
            </div>
         </div>
      </div>
   </section>

   <!-- Buttons -->
   <section class="section">
      <div class="container">
         <p class="eyebrow">Components</p>
         <h2>Buttons</h2>
         <div
            class="u-d-flex gap-sm u-flex-wrap"
            style="margin-top: 2rem; align-items: center;"
         >
            <Button href="#">Primary</Button>
            <Button href="#" variant="outline">Outline</Button>
            <Button href="#" variant="ghost">Ghost</Button>
            <Button href="#">
               With icon
               <ArrowRight slot="icon-right" />
            </Button>
         </div>
      </div>
   </section>

   <!-- Accordion -->
   <section class="section">
      <div class="container">
         <div class="u-d-flex gap-xl u-flex-wrap">
            <div style="flex: 1; min-width: 220px;">
               <p class="eyebrow">Components</p>
               <h2>Accordion</h2>
               <p class="u-text-soft">
                  Animated with GSAP. ARIA attributes auto-applied on init.
               </p>
            </div>
            <div style="flex: 2; min-width: 300px;">
               <AccordionList>
                  <AccordionItem title="What is this starter template?">
                     <p>
                        A production-ready Astro 7 base with CSS cascade layers,
                        fluid typography, GSAP components, and an SEO layout —
                        no jQuery or Webflow required.
                     </p>
                  </AccordionItem>
                  <AccordionItem title="How do I customize the design tokens?">
                     <p>
                        All design tokens live in <code
                           >src/styles/tokens.css</code
                        >. Colors, type scale, spacing, and radii are CSS custom
                        properties you can override at <code>:root</code>.
                     </p>
                  </AccordionItem>
                  <AccordionItem title="Can I add more components?">
                     <p>
                        Yes. Follow the pattern in <code>Accordion.astro</code> and
                        <code>Dialog.astro</code>. Scripts are bundled by Vite
                        and deduped automatically by Astro.
                     </p>
                  </AccordionItem>
               </AccordionList>
            </div>
         </div>
      </div>
   </section>

   <!-- Dialog -->
   <section class="section">
      <div class="container">
         <p class="eyebrow">Components</p>
         <h2>Dialog</h2>
         <p class="u-text-soft">
            Uses the native <code>&lt;dialog&gt;</code> element. Closes on backdrop
            click or Escape.
         </p>
         <div style="margin-top: 2rem;">
            <Dialog triggerLabel="Open dialog">
               <div class="rich-text">
                  <h3>Dialog title</h3>
                  <p>
                     This dialog uses the native <code>&lt;dialog&gt;</code> element
                     with
                     <code>showModal()</code> and <code>close()</code>. IDs and
                     ARIA attributes are auto-generated on init.
                  </p>
                  <p class="u-text-soft paragraph-sm">
                     Click outside or the × button to close.
                  </p>
               </div>
            </Dialog>
         </div>
      </div>
   </section>

   <!-- Typography -->
   <section class="section">
      <div class="container">
         <p class="eyebrow">Typography</p>
         <h2>Type scale</h2>
         <div style="margin-top: 2rem;">
            <h1>Heading 1</h1>
            <h2>Heading 2</h2>
            <h3>Heading 3</h3>
            <h4>Heading 4</h4>
            <h5>Heading 5</h5>
            <h6>Heading 6</h6>
            <span class="u-divider" style="margin: 2rem 0; display: block;"
            ></span>
            <p class="paragraph-xl">
               Paragraph XL — lead copy or hero subtext.
            </p>
            <p class="paragraph-lg">Paragraph LG — intro or callout text.</p>
            <p>
               Paragraph base — body copy. Text wraps with <code
                  >text-wrap: pretty</code
               > to avoid orphaned words.
            </p>
            <p class="paragraph-sm u-text-soft">
               Paragraph SM — captions, metadata, helper text.
            </p>
            <p class="paragraph-xs u-text-soft">
               Paragraph XS — Even smaller elements.
            </p>
            <p class="eyebrow">Eyebrow label</p>
         </div>
      </div>
   </section>

   <!-- Rich text -->
   <section class="section rich-text">
      <div class="container">
         <p class="eyebrow">Typography</p>
         <h2>Rich text</h2>
         <div style="max-width: 65ch; margin-top: 2rem;">
            <h2>Here's what to expect</h2>
            <p>
               What follows from here is just a bunch of absolute nonsense. It
               includes every sensible typographic element I could think of,
               like <strong>bold text</strong>, unordered lists, ordered lists, <a
                  href="http://google.com">links</a
               >, block quotes, <code>inline code</code>, and even <em
                  >italics</em
               >.
            </p>
            <p>
               It's important to cover all of these use cases for a few reasons:
            </p>
            <ol>
               <li>We want everything to look good out of the box.</li>
               <li>
                  Really just the first reason, that's the whole point of the
                  template.
               </li>
               <li>
                  Here's a third pretend reason though a list with three items
                  looks more realistic than a list with two items.
               </li>
            </ol>
            <p>Now we're going to try out another header style.</p>
            <h3>Typography should be easy</h3>
            <p>
               So that's a header for you — with any luck if we've done our job
               correctly that will look pretty reasonable.
            </p>
            <p>Something a wise person once told me about typography is:</p>
            <blockquote>
               Typography is pretty important if you don't want your stuff to
               look like trash. Make it good then it won't be bad.
            </blockquote>
            <p>
               It's probably important that images look okay here by default as
               well:
            </p>
            <figure>
               <img
                  src="https://cdn.prod.website-files.com/67f70e851318720a65af715b/67feaed59bc34c768ee92ce6_6727c6a3a33d0c93b019f82f_placeholder.webp"
                  loading="lazy"
                  alt="Placeholder image"
               />
               <figcaption>
                  Contrary to popular belief, Lorem Ipsum is not simply random
                  text. It has roots in a piece of classical Latin literature
                  from 45 BC, making it over 2000 years old.
               </figcaption>
            </figure>
            <p>
               Now here's an example of an unordered list to make sure that
               looks good, too:
            </p>
            <ul>
               <li>So here is the first item in this list.</li>
               <li>In this example we're keeping the items short.</li>
               <li>Again, just needed one more list item here.</li>
            </ul>
            <p>And that's the end of this section.</p>
            <h2>Let's stack headings</h2>
            <h3>We should make sure that looks good, too.</h3>
            <p>
               Sometimes you have headings directly underneath each other. In
               those cases you often have to undo the top margin on the second
               heading because it usually looks better for the headings to be
               closer together than a paragraph followed by a heading should be.
            </p>
            <h3>When a heading comes after a paragraph …</h3>
            <p>
               When a heading comes after a paragraph, we need a bit more space,
               like I already mentioned above. We're almost done.
            </p>
            <p>
               This is just a closing statement or paragraph, because it kinda
               looks weird jumping right to another heading.
            </p>
            <h4>We haven't used an h4 yet</h4>
            <p>
               But now we have. Please don't use <strong>h5</strong> or <strong
                  >h6</strong
               > in your content, Medium only supports two heading levels for a reason.
            </p>
            <p>
               We are not styling them out of the box because <strong>h4</strong
               > elements are already so small that they are the same size as the
               body copy. What are we supposed to do with an <strong>h5</strong
               >, make it <em>smaller</em> than the body copy? No thanks.
            </p>
            <h3>We need to think about stacked headings.</h3>
            <h4>
               Let's make sure we don't screw that up with h4 elements, either.
            </h4>
            <p>
               Phew, with any luck we have styled the headings above this text
               and they look good.
            </p>
            <p>
               Let's add a closing paragraph here so things end with a decently
               sized block of text. I can't explain why I want things to end
               that way but I have to assume it's because I think things will
               look weird or unbalanced if there is a heading too close to the
               end of the document.
            </p>
            <p>
               What we have here is probably long enough, but adding this final
               sentence can't hurt.
            </p>
         </div>
      </div>
   </section>

   <!-- Form -->
   <section class="section">
      <div class="container">
         <p class="eyebrow">Components</p>
         <h2>Form</h2>
         <Form
            id="demo-form"
            error="Something went wrong. Please check your details and try again."
            style="max-width: 480px; margin-top: 2rem;"
         >
            <div class="input-group">
               <label class="input-label" for="demo-name">Full name</label>
               <input
                  class="input"
                  type="text"
                  id="demo-name"
                  name="name"
                  placeholder="Jane Smith"
               />
            </div>
            <div class="input-group">
               <label class="input-label" for="demo-email">Email address</label>
               <input
                  class="input"
                  type="email"
                  id="demo-email"
                  name="email"
                  placeholder="jane@example.com"
                  value="jane@example"
                  aria-invalid="true"
                  aria-describedby="demo-email-error"
               />
            </div>
            <span class="field-error" id="demo-email-error">
               Enter a valid email address.
            </span>

            <div class="input-group cc-textarea">
               <label class="input-label" for="demo-message">Message</label>
               <textarea
                  class="input"
                  id="demo-message"
                  name="message"
                  placeholder="Your message..."></textarea>
            </div>

            <div class="input-group cc-select">
               <label class="input-label" for="demo-budget">Budget</label>
               <select class="input" id="demo-budget" name="budget">
                  <option value="" selected>Select a range…</option>
                  <option value="sm">Under $5,000</option>
                  <option value="md">$5,000 – $20,000</option>
                  <option value="lg">$20,000+ </option>
               </select>
               <span class="select-icon">
                  <ChevronDown stroke={1.5} />
               </span>
            </div>

            <fieldset class="input-group cc-choice">
               <legend class="choice-label">Please select inquiry type</legend>
               <div class="choice-list">
                  <label class="choice-item">
                     <input
                        class="choice-input"
                        type="radio"
                        name="inquiry"
                        value="general"
                        checked
                     />
                     <span>General</span>
                  </label>
                  <label class="choice-item">
                     <input
                        class="choice-input"
                        type="radio"
                        name="inquiry"
                        value="support"
                     />
                     <span>Support</span>
                  </label>
                  <label class="choice-item">
                     <input
                        class="choice-input"
                        type="radio"
                        name="inquiry"
                        value="sales"
                     />
                     <span>Sales</span>
                  </label>
               </div>
            </fieldset>

            <Button type="submit" full>Send message</Button>

            <div class="input-group cc-choice" style="padding-top: 1rem;">
               <label class="choice-item">
                  <input
                     class="choice-input"
                     type="checkbox"
                     name="newsletter"
                  />
                  <span>Subscribe to product updates and news</span>
               </label>
            </div>
         </Form>
      </div>
   </section>

   <!-- Spacing Scale -->
   <section class="section cc-end">
      <div class="container">
         <p class="eyebrow">Tokens</p>
         <h2>Fluid spacing scale</h2>
         <p class="u-text-soft" style="margin-bottom: 2rem;">
            Resize the viewport to see each value interpolate between its min
            and max.
         </p>
         <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            {
               [
                  { name: "--space-2", min: 2, max: 2 },
                  { name: "--space-4", min: 4, max: 4 },
                  { name: "--space-6", min: 6, max: 6 },
                  { name: "--space-8", min: 8, max: 8 },
                  { name: "--space-12", min: 10, max: 12 },
                  { name: "--space-16", min: 12, max: 16 },
                  { name: "--space-20", min: 16, max: 20 },
                  { name: "--space-24", min: 18, max: 24 },
                  { name: "--space-28", min: 20, max: 28 },
                  { name: "--space-32", min: 24, max: 32 },
                  { name: "--space-36", min: 26, max: 36 },
                  { name: "--space-40", min: 28, max: 40 },
                  { name: "--space-44", min: 32, max: 44 },
                  { name: "--space-48", min: 32, max: 48 },
                  { name: "--space-56", min: 36, max: 56 },
                  { name: "--space-64", min: 44, max: 64 },
                  { name: "--space-72", min: 48, max: 72 },
                  { name: "--space-80", min: 56, max: 80 },
                  { name: "--space-88", min: 60, max: 88 },
                  { name: "--space-96", min: 64, max: 96 },
               ].map(({ name, min, max }) => (
                  <div style="display: flex; align-items: center; gap: 1rem;">
                     <code style="flex: 0 0 8.5rem; font-size: 0.8125rem; color: var(--color-text-soft);">
                        {name}
                     </code>
                     <div
                        style={`height: 6px; width: var(${name}); min-width: 2px; background: var(--color-text-accent); border-radius: 3px; flex-shrink: 0;`}
                     />
                     <span style="font-size: 0.8125rem; color: red; white-space: nowrap;">
                        {min === max ? `${min}px` : `${min}–${max}px`}
                     </span>
                  </div>
               ))
            }
         </div>
      </div>
   </section>
</BaseLayout>

<style>
   @layer base, component, utility;

   @layer component {
      /* Horizontal padding + container width come from global.css */
      .section {
         padding-block: 4rem;
         border-top: 1px solid var(--color-border);
      }

      .section.cc-hero {
         padding-block: 8rem 6rem;
         border-top: none;
      }

      .section.cc-end {
         padding-bottom: 8rem;
      }
   }
</style>
