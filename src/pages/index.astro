---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import ArrowRight from "@assets/icons/ArrowRight.astro";
import Company from "@assets/icons/Company.astro";
---

<BaseLayout
   title="Astro Starter"
   description="A modern Astro 7 starter with CSS layers, General Sans, GSAP, and utility components."
   topBanner={false}
   nav={false}
   footer={false}
>
   <section class="section">
      <div class="container">
         <div class="logo"><Company class="u-svg-fluid" /></div>
         <div class="content-bot">
            <div>
               <h1 class="heading eyebrow">Boilerplate</h1>
               <p class="text h4">
                  Modern Astro template with minimal CSS, fluid typography,
                  GSAP, and accessible components.
               </p>
               <div class="button-group">
                  <Button href="#">
                     Get started
                     <ArrowRight slot="icon-right" />
                  </Button>
                  <Button href="#" variant="outline"> View components </Button>
               </div>
            </div>
            <div class="caption eyebrow">
               <p>For internal use</p>
               <p>V. 0.1</p>
            </div>
         </div>
      </div>
   </section>
</BaseLayout>

<style>
   @layer base, component, utility;

   @layer component {
      .section {
         padding-block: var(--page-gutter);
         min-height: 100svh;
         display: flex;
         flex-direction: column;
      }
      .container {
         flex: 1;
         display: flex;
         flex-direction: column;
         justify-content: space-between;
      }
      .logo {
         width: 100%;
      }
      .content-bot {
         display: flex;
         flex-direction: column;
         gap: var(--gap-md);
      }
      .heading {
         margin-bottom: var(--space-em-100);
      }
      .text {
         margin-bottom: var(--space-em-100);
      }
      .button-group {
         display: inline-flex;
         gap: var(--gap-sm);
      }
      .caption {
         color: var(--color-text-soft);
         padding-top: var(--space-24);
         padding-bottom: var(--space-16);
         border-top: 1px solid var(--color-border-default);
         display: flex;
         align-items: center;
         justify-content: space-between;
         gap: var(--gap-sm);
      }

      @container container (min-width: 40rem) {
         .content-bot {
            display: grid;
            grid-template-columns: 1.25fr 1fr;
            align-items: end;
         }
         .caption {
            padding: 0 0 var(--space-12);
            border: none;
            justify-content: end;
         }
      }
   }
</style>
