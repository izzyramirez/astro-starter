---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  ogType?: string;
  robots?: string;
  locale?: string;
  // TODO: Set your site name
  siteName?: string;
  // TODO: Add your social profile URLs
  sameAs?: string[];
  datePublished?: Date;
  dateModified?: Date;
  articleAuthor?: string;
  breadcrumbItem?: string;
}

const {
  // TODO: Replace default title with your site/brand name
  title = 'Your Site Name',
  description,
  // TODO: Add your default OG image at /images/og/og-image.jpg
  ogImage = '/images/og/og-image.jpg',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt = description ?? '',
  ogType = 'website',
  robots,
  locale = 'en_US',
  // TODO: Replace with your site name
  siteName = 'Your Site Name',
  // TODO: Add your social profile URLs
  sameAs = [
    // 'https://linkedin.com/in/your-handle',
    // 'https://github.com/your-handle',
  ],
  datePublished,
  dateModified,
  // TODO: Replace with your site URL
  articleAuthor = 'https://your-site.com',
  breadcrumbItem,
} = Astro.props;

// TODO: Replace with your profile image path
const personImage = '/images/profile.jpg';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const personImageURL = Astro.site ? new URL(personImage, Astro.site).href : personImage;
const isArticle = ogType === 'article' && !!datePublished;

const siteURL = Astro.site?.href ?? 'https://your-site.com';
const siteId = `${siteURL}#/schema.org`;

const webPageEntity: Record<string, unknown> = {
  '@type': 'WebPage',
  '@id': canonicalURL.href,
  url: canonicalURL.href,
  name: title,
  ...(description ? { description } : {}),
  isPartOf: { '@id': `${siteId}/WebSite` },
  about: { '@id': `${siteId}/Person` },
  ...(isArticle ? { breadcrumb: { '@id': `${canonicalURL.href}#breadcrumb` } } : {}),
};

const graph: unknown[] = [
  {
    '@type': 'Person',
    '@id': `${siteId}/Person`,
    // TODO: Replace with your name
    name: 'Your Name',
    url: siteURL,
    image: {
      '@type': 'ImageObject',
      '@id': `${siteId}/PersonImage`,
      url: personImageURL,
      width: 1000,
      height: 1000,
    },
    sameAs,
  },
  {
    '@type': 'WebSite',
    '@id': `${siteId}/WebSite`,
    url: siteURL,
    name: siteName,
    publisher: { '@id': `${siteId}/Person` },
  },
  webPageEntity,
];

if (isArticle) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalURL.href}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
      { '@type': 'ListItem', position: 2, name: breadcrumbItem ?? title, item: canonicalURL.href },
    ],
  });
  graph.push({
    '@type': 'BlogPosting',
    '@id': `${canonicalURL.href}#article`,
    headline: title,
    ...(description ? { description } : {}),
    url: canonicalURL.href,
    datePublished: datePublished!.toISOString(),
    dateModified: (dateModified ?? datePublished!).toISOString(),
    author: { '@id': `${siteId}/Person` },
    publisher: { '@id': `${siteId}/Person` },
    isPartOf: { '@id': canonicalURL.href },
    mainEntityOfPage: { '@id': canonicalURL.href },
    image: {
      '@type': 'ImageObject',
      url: Astro.site ? new URL(ogImage, Astro.site).href : ogImage,
      width: ogImageWidth,
      height: ogImageHeight,
    },
  });
}

const schema = { '@context': 'https://schema.org', '@graph': graph };
---

<!-- Core -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
{robots && <meta name="robots" content={robots} />}

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={Astro.site ? new URL(ogImage, Astro.site) : ogImage} />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content={siteName} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={ogImageAlt} />

<!-- Article -->
{ogType === 'article' && datePublished && (
  <meta property="article:published_time" content={datePublished.toISOString()} />
)}
{ogType === 'article' && dateModified && (
  <meta property="article:modified_time" content={dateModified.toISOString()} />
)}
{ogType === 'article' && (
  <meta property="article:author" content={articleAuthor} />
)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={Astro.site ? new URL(ogImage, Astro.site) : ogImage} />

<!-- JSON-LD -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
