---
import { Font } from "astro:assets";
import SEO from "./SEO.astro";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";
import SkipLink from "@components/SkipLink.astro";
import TopBanner from "@components/TopBanner.astro";
import "@/styles/global.css";

interface Props {
   title?: string;
   description?: string;
   ogImage?: string;
   ogImageWidth?: number;
   ogImageHeight?: number;
   ogImageAlt?: string;
   ogType?: string;
   robots?: string;
   siteName?: string;
   sameAs?: string[];
   datePublished?: Date;
   dateModified?: Date;
   articleAuthor?: string;
   breadcrumbItem?: string;
   lang?: string;
   topBanner?: boolean;
   nav?: boolean;
   footer?: boolean;
}

const {
   lang = "en",
   topBanner = true,
   nav = true,
   footer = true,
   ...seoProps
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
   <head>
      <Font cssVariable="--font-primary" preload />
      <SEO {...seoProps} />
      <slot name="head" />
   </head>
   <body>
      <SkipLink />
      <div class="page-wrap">
         {
            topBanner &&
               (Astro.slots.has("banner") ? (
                  <slot name="banner" />
               ) : (
                  <TopBanner />
               ))
         }
         {nav && <Nav />}
         <main id="main-content" tabindex="-1">
            <slot />
         </main>
         {footer && <Footer />}
      </div>
      <script>
         import "@/scripts/main";
      </script>
   </body>
</html>
