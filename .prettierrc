{
   "plugins": ["prettier-plugin-astro"],
   "useTabs": false,
   "tabWidth": 3,
   "printWidth": 80,
   "semi": true,
   "singleQuote": false,
   "trailingComma": "all",
   "bracketSameLine": false,
   "overrides": [
      {
         "files": "*.astro",
         "options": { "parser": "astro" }
      },
      {
         "files": ["*.json", "*.jsonc", "*.yaml", "*.yml"],
         "options": { "tabWidth": 2 }
      }
   ]
}
